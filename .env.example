# Copier ce fichier vers .env puis adapter les valeurs :  cp .env.example .env
# Le fichier .env n'est PAS commité (voir .gitignore).

# Base PostgreSQL : créée au premier démarrage avec ces valeurs
POSTGRES_DB=taches
POSTGRES_USER=taches
POSTGRES_PASSWORD=changez-moi

# Ports publiés sur la machine hôte
WEB_PORT=8000
ADMINER_PORT=8081
